{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private authenticated user profile, bankroll configuration, alert thresholds, and UI preferences for LambdaQuant.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID and request.auth.uid."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email address (PII, owner-only)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name from Google profile."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Google avatar URL."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Active visual theme preference."
        },
        "timezonePref": {
          "type": "string",
          "enum": ["gmt-6", "local"],
          "description": "24-hour clock timezone preference."
        },
        "activeModel": {
          "type": "string",
          "enum": [
            "bivariate-poisson-xg-elo",
            "dixon-coles",
            "negative-binomial",
            "ml-gbdt",
            "ensemble"
          ],
          "description": "Preferred quantitative forecasting model."
        },
        "bankrollConfig": {
          "type": "object",
          "description": "Native map holding initialBankroll, strategy, flatPercent, flatFixed, maxStakePercent, dailyStopLossPercent, minEvThreshold, and currency."
        },
        "alertSettings": {
          "type": "object",
          "description": "Native map holding pushEnabled, soundEnabled, minEvPercent, minEdgePercent, and sports toggle map."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp (request.time)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (request.time)."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "theme",
        "timezonePref",
        "activeModel",
        "bankrollConfig",
        "alertSettings",
        "createdAt",
        "updatedAt"
      ]
    },
    "BetDocument": {
      "title": "BetDocument",
      "description": "Single quantitative bet or parlay record owned by a user inside their private ledger.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable owner UID matching parent userId and request.auth.uid."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO timestamp string of bet placement."
        },
        "monthKey": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "Month bucket key (YYYY-MM) for monthly PDF reports."
        },
        "sport": {
          "type": "string",
          "enum": ["soccer", "nba", "nhl", "football"],
          "description": "Sport identifier."
        },
        "league": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "League or competition name."
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional upstream match identifier."
        },
        "matchLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Formatted fixture title."
        },
        "side": {
          "type": "string",
          "enum": ["over", "under"],
          "description": "Primary total/selection direction."
        },
        "line": {
          "type": "number",
          "description": "Numeric betting line or handicap value."
        },
        "marketType": {
          "type": "string",
          "enum": ["totals", "btts", "1x2", "asian-handicap", "parlay"],
          "description": "Optional market category."
        },
        "selectionKey": {
          "type": "string",
          "enum": [
            "over",
            "under",
            "btts_yes",
            "btts_no",
            "home",
            "draw",
            "away",
            "ah_home",
            "ah_away",
            "parlay"
          ],
          "description": "Optional normalized selection key."
        },
        "marketLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Optional human-readable market description."
        },
        "finalScore": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Optional settled final score label."
        },
        "bookmaker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Bookmaker name."
        },
        "odds": {
          "type": "number",
          "description": "Decimal odds taken."
        },
        "closingOdds": {
          "type": "number",
          "description": "Closing decimal odds for CLV tracking."
        },
        "modelProb": {
          "type": "number",
          "description": "Model estimated probability in [0, 1]."
        },
        "edge": {
          "type": "number",
          "description": "Probability edge in [-1, 1]."
        },
        "ev": {
          "type": "number",
          "description": "Expected value ratio."
        },
        "stake": {
          "type": "number",
          "description": "Wagered stake amount."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "won", "lost", "void"],
          "description": "Bet lifecycle status; won/lost/void are terminal and immutable once settled."
        },
        "pnl": {
          "type": "number",
          "description": "Settled profit or loss."
        },
        "modelUsed": {
          "type": "string",
          "enum": [
            "bivariate-poisson-xg-elo",
            "dixon-coles",
            "negative-binomial",
            "ml-gbdt",
            "ensemble"
          ],
          "description": "Quantitative model used to evaluate this bet."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp (request.time)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (request.time)."
        }
      },
      "required": [
        "ownerId",
        "date",
        "monthKey",
        "sport",
        "league",
        "matchLabel",
        "side",
        "line",
        "bookmaker",
        "odds",
        "closingOdds",
        "modelProb",
        "edge",
        "ev",
        "stake",
        "status",
        "pnl",
        "modelUsed",
        "createdAt",
        "updatedAt"
      ]
    },
    "ParlayLegDocument": {
      "title": "ParlayLegDocument",
      "description": "Active selection saved in the user's Parlay +EV slip subcollection.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable owner UID matching parent userId and request.auth.uid."
        },
        "legId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Client selection identifier used to match live pick cards."
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Match identifier."
        },
        "sport": {
          "type": "string",
          "enum": ["soccer", "nba", "nhl", "football"],
          "description": "Sport identifier."
        },
        "league": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "League name."
        },
        "matchLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Fixture title."
        },
        "homeTeam": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Home team name."
        },
        "awayTeam": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Away team name."
        },
        "homeLogo": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional home team logo URL."
        },
        "awayLogo": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional away team logo URL."
        },
        "marketType": {
          "type": "string",
          "enum": ["totals", "btts", "1x2", "asian-handicap"],
          "description": "Market category for this leg."
        },
        "selectionKey": {
          "type": "string",
          "enum": [
            "over",
            "under",
            "btts_yes",
            "btts_no",
            "home",
            "draw",
            "away",
            "ah_home",
            "ah_away"
          ],
          "description": "Selection key."
        },
        "marketLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Human-readable selection label."
        },
        "line": {
          "type": "number",
          "description": "Line or handicap."
        },
        "bookmaker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Bookmaker name."
        },
        "odds": {
          "type": "number",
          "description": "Decimal odds."
        },
        "modelProb": {
          "type": "number",
          "description": "Model win probability in [0, 1]."
        },
        "pushProb": {
          "type": "number",
          "description": "Model push probability in [0, 1]."
        },
        "ev": {
          "type": "number",
          "description": "Expected value ratio."
        },
        "modelType": {
          "type": "string",
          "enum": [
            "bivariate-poisson-xg-elo",
            "dixon-coles",
            "negative-binomial",
            "ml-gbdt",
            "ensemble"
          ],
          "description": "Model used to price this leg."
        },
        "homeLambda": {
          "type": "number",
          "description": "Home expected scoring rate."
        },
        "awayLambda": {
          "type": "number",
          "description": "Away expected scoring rate."
        },
        "homeElo": {
          "type": "number",
          "description": "Home Elo rating."
        },
        "awayElo": {
          "type": "number",
          "description": "Away Elo rating."
        },
        "bivariateCov": {
          "type": "number",
          "description": "Bivariate Poisson covariance parameter."
        },
        "rho": {
          "type": "number",
          "description": "Dixon-Coles correlation parameter."
        },
        "alpha": {
          "type": "number",
          "description": "Negative Binomial dispersion parameter."
        },
        "mlFeatures": {
          "type": "object",
          "description": "Native map holding paceIndex, volatilityIndex, shotQualityDiff, defensiveFragility, and restAdvantage."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp (request.time)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (request.time)."
        }
      },
      "required": [
        "ownerId",
        "legId",
        "matchId",
        "sport",
        "league",
        "matchLabel",
        "homeTeam",
        "awayTeam",
        "marketType",
        "selectionKey",
        "marketLabel",
        "line",
        "bookmaker",
        "odds",
        "modelProb",
        "pushProb",
        "ev",
        "modelType",
        "homeLambda",
        "awayLambda",
        "homeElo",
        "awayElo",
        "bivariateCov",
        "rho",
        "alpha",
        "mlFeatures",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserWorkspace"
      },
      "description": "Owner-isolated user profile, bankroll config, alert settings, and workspace preferences."
    },
    "/users/{userId}/bets/{betId}": {
      "schema": {
        "$ref": "#/entities/BetDocument"
      },
      "description": "Owner-isolated quantitative betting ledger with terminal-state settlement protection."
    },
    "/users/{userId}/parlayLegs/{legId}": {
      "schema": {
        "$ref": "#/entities/ParlayLegDocument"
      },
      "description": "Owner-isolated active Parlay +EV slip selections."
    }
  }
}
